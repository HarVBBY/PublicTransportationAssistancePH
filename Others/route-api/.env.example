# Copy this file to ".env" and adjust. ".env" is git-ignored - never commit secrets.

# Web server
PORT=8000
# 127.0.0.1 = only this computer. Use 0.0.0.0 to open the site to your phone on the same Wi-Fi.
HOST=127.0.0.1

# Optional: allow other web origins to call the API (comma-separated, or *). Default: localhost only.
# CORS_ORIGIN=https://example.com
