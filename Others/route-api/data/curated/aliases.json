    { "match": "SM City Grand Central", "aliases": ["SM Grand Central", "Grand Central", "SMGC"] },
    { "match": "Fernando Poe Jr.", "aliases": ["Roosevelt", "Roosevelt Station", "FPJ", "Munoz"] },
    { "match": "Monumento", "type": "station", "aliases": ["LRT Monumento", "Bonifacio Monument", "Monumento Circle"] },
    { "match": "Caloocan City Hall", "aliases": ["Caloocan Hall"] },
    { "match": "Valenzuela City Hall", "aliases": ["Valenzuela Hall"] },
    { "match": "Malabon City Hall", "aliases": ["Malabon Hall"] },
    { "match": "Navotas City Hall", "aliases": ["Navotas Hall"] },
    { "match": "Divisoria", "aliases": ["Divisoria Market", "168 Mall"] }
  ]
